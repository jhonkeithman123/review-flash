{
  "name": "review-flash-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev cypress:open --parallel",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "storybook": "turbo run storybook",
    "build-storybook": "turbo run build-storybook",
    "check:pressbook": "turbo run test:pressbook",
    "cypress:open": "turbo run cypress:open",
    "cypress:run": "turbo run cypress:run",
    "cypress": "turbo run cypress:open",
    "build:pressbook": "pnpm --filter @dit/pressbook build",
    "publish:pressbook": "pnpm --filter @dit/pressbook publish --access public",
    "test:load": "k6 run loadTester.js",
    "test:load:live": "k6 run -e TARGET_URL=https://review-flash.vercel.app loadTester.js",
    "test:load:local": "k6 run -e TARGET_URL=http://localhost:3000 loadTester.js",
    "seeResult": "npx open-cli summary.html"
  },
  "packageManager": "pnpm@10.5.2",
  "devDependencies": {
    "turbo": "^2.11.2"
  }
}
